# ==============================================================================
# LUME Environment Configuration
# ==============================================================================

# Application Environment Mode ('development' | 'production' | 'test')
VITE_APP_MODE="production"

# Application Version
VITE_APP_VERSION="1.0.0"

# Optional: Port for local preview server (defaults to 3000)
PORT=3000

# Optional: Gemini API Key (if connecting to external Gemini intelligence service)
GEMINI_API_KEY=""

# Optional: Base URL for hosted application
VITE_APP_URL="https://lume-gov.onrender.com"
